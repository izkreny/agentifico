{
  "name": "typescript-native-lsp",
  "version": "1.0.0",
  "description": "TypeScript and JavaScript code intelligence from the language server TypeScript 7's own tsc speaks, with no typescript-language-server and no older TypeScript.",
  "author": {
    "name": "izkreny",
    "url": "https://github.com/izkreny"
  },
  "repository": "https://github.com/izkreny/agentifico",
  "homepage": "https://github.com/izkreny/agentifico/tree/main/plugins/typescript-native-lsp",
  "license": "MIT",
  "keywords": [
    "typescript",
    "javascript",
    "lsp",
    "language-server",
    "code-intelligence"
  ],
  "lspServers": {
    "typescript": {
      "command": "tsc",
      "args": [
        "--lsp",
        "--stdio"
      ],
      "extensionToLanguage": {
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".js": "javascript",
        ".jsx": "javascriptreact",
        ".mts": "typescript",
        ".cts": "typescript",
        ".mjs": "javascript",
        ".cjs": "javascript"
      }
    }
  }
}
