{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["scripts/**", "*.js", "*.mjs"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 160
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noUselessUndefined": "error",
        "useSimplifiedLogicExpression": "error",
        "noExcessiveLinesPerFunction": "error",
        "noExcessiveCognitiveComplexity": "warn"
      },
      "correctness": {
        "noUnresolvedImports": "error",
        "noProcessGlobal": "error"
      },
      "performance": {
        "noAwaitInLoops": "error"
      },
      "style": {
        "noCommonJs": "error",
        "useForOf": "error",
        "useObjectSpread": "error",
        "noNestedTernary": "error",
        "useCollapsedIf": "error",
        "noNegationElse": "error",
        "noParameterAssign": "error",
        "noExcessiveLinesPerFile": "warn"
      },
      "suspicious": {
        "noVar": "error",
        "noEmptyBlockStatements": "error",
        "useArraySortCompare": "error",
        "noShadow": "error",
        "noUnnecessaryConditions": "error",
        "noLoopFunc": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["scripts/test/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          },
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all"
    }
  }
}
