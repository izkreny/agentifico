{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["scripts/**", "*.js", "*.mjs"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 160
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "performance": {
        "noAwaitInLoops": "error"
      },
      "style": {
        "noCommonJs": "error",
        "useForOf": "error",
        "useObjectSpread": "error"
      },
      "suspicious": {
        "noVar": "error",
        "noEmptyBlockStatements": "error",
        "useArraySortCompare": "error",
        "noShadow": "error",
        "noUnnecessaryConditions": "error",
        "noLoopFunc": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all"
    }
  }
}
