{
  "name": "agents-guru-checks",
  "private": true,
  "description": "The mechanical checks of the agents-guru skill: markdownlint with this package's own rules, Vale with its prose rules, and their bench",
  "type": "module",
  "engines": {
    "node": ">=26.1"
  },
  "scripts": {
    "check": "node scripts/check.js",
    "test": "vitest run scripts/test/",
    "lint": "biome check scripts/",
    "mutate": "nice -n 19 ionice -c 3 stryker run --incremental"
  },
  "dependencies": {
    "markdownlint": "0.42.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "vitest": "5.0.5"
  }
}
